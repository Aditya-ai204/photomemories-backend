# PhotoMemories AI Backend - Environment Template
# Authoritative Source: PhotoMemories_Backend_PRD_V2.pdf (Pages 28-29)

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-sample-123.region.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=replace_with_min_32_char_random_secret
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=replace_with_another_32_char_random_secret
JWT_REFRESH_EXPIRY=7d

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Email (Nodemailer / SMTP)
EMAIL_USER=replace_with_email_user@example.com
EMAIL_PASSWORD=replace_with_email_app_password

# Encryption at Rest (AES-256-GCM - 32 bytes as 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Payments (Razorpay)
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# Frontend & CORS
# Development: http://localhost:3000 | Production: https://photomemories.ai
FRONTEND_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@photomemories.ai

# Server Runtime
NODE_ENV=development
PORT=3001
